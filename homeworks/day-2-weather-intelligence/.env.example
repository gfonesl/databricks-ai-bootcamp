# Local or manual embedding execution only. Do not commit a populated .env file.
# Databricks Apps inject PG* and LAKEBASE_ENDPOINT from the postgres resource.
PGHOST=
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=
PGSSLMODE=require
LAKEBASE_ENDPOINT=projects/<project>/branches/<branch>/endpoints/<endpoint>
DATABRICKS_CONFIG_PROFILE=BOOTCAMP
WEATHER_HTTP_USER_AGENT=weather-intelligence-bootcamp/1.0 (contact: your-email@example.com)